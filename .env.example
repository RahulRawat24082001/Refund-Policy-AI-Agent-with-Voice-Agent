# Copy this file to .env and fill in your real values.

# --- Supabase ---------------------------------------------------------------
# Project Settings -> API -> Project URL / anon or service_role key.
# This demo disables RLS (see db/schema.sql), so the anon key is fine for
# local development. Use the service_role key only on a trusted backend.
SUPABASE_URL=https://supabase-url-here.supabase.co
SUPABASE_KEY=service_role_key_here
# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-key-here

# Optional overrides (defaults shown):
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
